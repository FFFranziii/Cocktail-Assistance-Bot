    {
        "id": "946ebaa2552d257d",
        "type": "function",
        "z": "d54599eed3170d11",
        "name": "function 2",
        "func": "// --- Cocktailname aus Rasa abrufen ---\nlet cocktailName = msg.payload.cocktail; // z.B. \"Moscow Mule\"\n\nif (!cocktailName || typeof cocktailName !== \"string\") {\n    msg.payload = { text: \"Kein Cocktailname übergeben.\" };\n    return msg;\n}\n\n// für Vergleich normalisieren\nlet cocktailNameLower = cocktailName.toLowerCase();\n\n// --- Zutat-Map laden ---\nlet zutatMap = global.get(\"zutatMap\");\nif (!zutatMap) {\n    msg.payload = { text: \"Die Zutatendaten sind noch nicht geladen.\" };\n    return msg;\n}\n\n// --- Cocktail suchen ---\nlet gefundenerCocktail = null;\n\nfor (let zutat in zutatMap) {\n    for (let cocktail of zutatMap[zutat]) {\n        if (cocktail.name.toLowerCase() === cocktailNameLower) {\n            gefundenerCocktail = cocktail;\n            break;\n        }\n    }\n    if (gefundenerCocktail) break;\n}\n\n// --- Ergebnis bauen ---\nif (!gefundenerCocktail) {\n    msg.payload = {\n        text: `Ich habe keinen Cocktail namens \"${cocktailName}\" gefunden.`\n    };\n} else {\n    msg.payload = {\n        name: gefundenerCocktail.name,      // Original-Schreibweise\n        zutaten: gefundenerCocktail.zutaten // Originale Zutatenliste\n    };\n}\n\nreturn msg;\n\n",
