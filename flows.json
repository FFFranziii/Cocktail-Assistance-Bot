    {
        "id": "c2619c216fe2dad9",
        "type": "function",
        "z": "d54599eed3170d11",
        "name": "function 3",
        "func": "// --- payload aus Rasa abrufen ---\nlet userZutaten = msg.payload.zutaten;\n\nif (!Array.isArray(userZutaten)) {\n    userZutaten = [userZutaten];\n}\n\nuserZutaten = userZutaten.map(z => z.toLowerCase());\n\n// --- Zutat-Map laden ---\nlet zutatMap = global.get(\"zutatMap\");\nif (!zutatMap) {\n    msg.payload = { text: \"Die Zutatendaten sind noch nicht geladen.\", cocktails: [] };\n    return msg;\n}\n\n// --- Für jede Zutat passende Cocktails sammeln ---\nlet zutatenTreffer = userZutaten.map(zutat => {\n    let treffer = [];\n\n    for (let mapZutat in zutatMap) {\n        if (mapZutat.includes(zutat)) {\n            treffer.push(...zutatMap[mapZutat]);\n        }\n    }\n\n    return treffer;\n});\n\n// --- Schnittmenge bilden (UND) ---\nlet cocktailMap = {};\n\nzutatenTreffer[0].forEach(c => {\n    cocktailMap[c.name] = c;\n});\n\nfor (let i = 1; i < zutatenTreffer.length; i++) {\n    let aktuelleNamen = new Set(zutatenTreffer[i].map(c => c.name));\n    for (let name in cocktailMap) {\n        if (!aktuelleNamen.has(name)) {\n            delete cocktailMap[name];\n        }\n    }\n}\n\nlet ergebnisse = Object.values(cocktailMap);\n\n// --- Ergebnis bauen ---\nif (ergebnisse.length === 0) {\n    msg.payload = {\n        text: \"Kein Cocktail mit allen genannten Zutaten gefunden.\",\n        cocktails: []\n    };\n} else {\n    msg.payload = {\n        cocktails: ergebnisse.map(c => ({\n            name: c.name,\n            zutaten: c.zutaten\n        }))\n    };\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
